# Database
MONGODB_URI=

# Public origin, no trailing slash (canonical URLs, sitemap, email links, admin invite links)
NEXT_PUBLIC_SITE_URL=https://www.eclecia-hitk.in

# NextAuth (required for session signing): `openssl rand -hex 32`
AUTH_SECRET=

# Google OAuth (optional; leave empty to hide "Continue with Google")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email OTPs via Resend. Without a key, dev logs OTPs to the server console;
# production refuses to send.
RESEND_API_KEY=
MAIL_FROM="Eclecia'27 <onboarding@your-domain>"

# Self-hosting / `next start` outside Vercel: let Auth.js trust the request host.
AUTH_TRUST_HOST=true

# Feature flags (default: false)
NEXT_PUBLIC_ENABLE_LOADER=false
# Sign-in/register pages AND event registration (event pages show "Opening soon" when off)
NEXT_PUBLIC_ENABLE_REGISTRATION=false
# Landing shows the fest dates
NEXT_PUBLIC_DATES_REVEALED=false

# Admin panel (/admin). Add the first admin with `bun run admin:add you@example.com`.
# Optional break-glass sign-in on /admin/login; leave empty to turn it off.
# Use something long and random: `openssl rand -base64 32`
ADMIN_MASTER_KEY=
# Optional: sign panel sessions with a separate secret (defaults to AUTH_SECRET).
ADMIN_SESSION_SECRET=

# Payment provider lookup (GET /api/payment/registrations/<REG-ID>, header `x-api-key`).
# Empty turns the endpoint off. `openssl rand -hex 32`
PAYMENT_API_KEY=
